# ---------------------------------------------------------------------------
# ChargeGrid Intelligence · Sprint 4
# Renomeie este arquivo para .env e preencha com as suas credenciais.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ---------------------------------------------------------------------------

# Chave da Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Endpoint da Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com

# Modelo primário do refactory (Bloco A)
OLLAMA_MODEL=gpt-oss:120b

# Modelo secundário do comparativo: mesma família, porte menor
OLLAMA_MODEL_ALT=gpt-oss:20b

# Terceiro modelo do comparativo: família distinta, para medir o efeito da
# arquitetura do modelo e não apenas o do seu tamanho
OLLAMA_MODEL_ALT2=gemma4:31b

# ---------------------------------------------------------------------------
# Sprint 4 · RAG
# ---------------------------------------------------------------------------

# Servidor Ollama que executa o modelo de embeddings. A Ollama Cloud não expõe
# o endpoint de embeddings, por isso o padrão é o servidor local:
#   brew install ollama   (ou https://ollama.com/download)
#   ollama serve &  &&  ollama pull nomic-embed-text
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Diretório de persistência do ChromaDB (fora do Git, recriado por ingestão)
CHROMA_DIR=.chroma
